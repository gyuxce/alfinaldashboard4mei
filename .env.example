# Ask KPI (OpenRouter) — salin ke .env.local (local) atau Vercel Environment Variables (prod)
# JANGAN commit file yang berisi API key asli.

# Primary key (pakai key untuk Nemotron 3 Super free)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Opsional: key terpisah untuk fallback Ultra (kalau key sama, boleh dikosongkan)
OPENROUTER_API_KEY_FALLBACK=sk-or-v1-yyyyyyyy

# Model free (default sudah di-code; override kalau perlu)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3-ultra-550b-a55b:free

# Opsional
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://aldashboardlc.vercel.app
OPENROUTER_APP_NAME=Ask KPI Dashboard
